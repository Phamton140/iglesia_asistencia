<Window x:Class="IglesiaAsistencia.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IglesiaAsistencia.ViewModels"
        xmlns:models="clr-namespace:IglesiaAsistencia.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="Asistencia Pro - Comunidad del Reino" Height="850" Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="White" BorderBrush="#EEE" BorderThickness="0,0,1,0">
            <Grid Margin="0,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="20,0,20,40">
                    <TextBlock Text="⛪" FontSize="50" HorizontalAlignment="Center"/>
                    <TextBlock Text="Comunidad del Reino" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource MenuButton}" Content="📊 Dashboard" Command="{Binding CambiarVistaCommand}" CommandParameter="Dashboard"/>
                    <Button Style="{StaticResource MenuButton}" Content="👥 Directorio" Command="{Binding CambiarVistaCommand}" CommandParameter="Personas"/>
                    <Button Style="{StaticResource MenuButton}" Content="📋 Asistencia" Command="{Binding CambiarVistaCommand}" CommandParameter="Asistencia"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="15">
                    <Button Style="{StaticResource MenuButton}" Content="⚙️ Configuración" Command="{Binding CambiarVistaCommand}" CommandParameter="Configuracion" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding GenerarBackupCommand}" Content="💾 Backup Manual" Background="#4CAF50"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido Principal -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding CurrentView}" FontSize="32" FontWeight="Bold" Foreground="#222"/>
                    <TextBlock Text="Gestión Inteligente de la Congregación" Foreground="Gray"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker SelectedDate="{Binding FechaSeleccionada}" Width="140" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportarPdfCommand}" Content="📥 DESCARGAR PDF" Background="Indigo" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding EnviarReporteCommand}" Content="📲 REPORTE WA"/>
                </StackPanel>
            </Grid>

            <!-- Secciones -->
            <Grid Grid.Row="1">
                
                <!-- VISTA: DASHBOARD -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding CurrentView}" Value="Dashboard"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource PremiumCard}" Background="#E8EAF6">
                                <StackPanel>
                                    <TextBlock Text="Asistentes Hoy" Foreground="#5C6BC0" FontWeight="Bold" FontSize="18"/>
                                    <TextBlock Text="{Binding AsistentesHoy.Count}" FontSize="48" FontWeight="Bold" Margin="0,10"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PremiumCard}" Background="#E1F5FE">
                                <StackPanel>
                                    <TextBlock Text="Total Personas" Foreground="#0288D1" FontWeight="Bold" FontSize="18"/>
                                    <TextBlock Text="{Binding Personas.Count}" FontSize="48" FontWeight="Bold" Margin="0,10"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PremiumCard}" Background="#FFF3E0">
                                <StackPanel>
                                    <TextBlock Text="🎂 Cumpleaños de la Semana" Foreground="#F57C00" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding CumpleañerosSemana}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="SemiBold" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Ninguna novedad" FontStyle="Italic" Foreground="Gray" Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HayCumpleaños}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        
                        <Border Style="{StaticResource PremiumCard}" Margin="10,20,10,10">
                            <StackPanel>
                                <TextBlock Text="📄 Generar Reportes PDF Estadísticos" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportarReporteDomingosCommand}" Content="Reporte de DOMINGOS" Background="Indigo" Margin="0,0,10,10"/>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportarReporteRangoCommand}" CommandParameter="Semana" Content="Reporte Semanal" Margin="0,0,10,10"/>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportarReporteRangoCommand}" CommandParameter="Mes" Content="Reporte Mensual" Margin="0,0,10,10"/>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportarReporteRangoCommand}" CommandParameter="Año" Content="Reporte Anual" Margin="0,0,10,10"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VISTA: CONFIGURACION -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="Configuracion">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    
                    <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,10">
                        <StackPanel Margin="10">
                            <TextBlock Text="Configuración General" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Nombre de la Iglesia" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding NombreIglesia, UpdateSourceTrigger=PropertyChanged}" Padding="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <TextBlock Text="Imagen Corporativa" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <Button Content="📁 SUBIR LOGO" Command="{Binding SeleccionarLogoCommand}" 
                                            Background="Indigo" Foreground="White" Padding="15,10" FontWeight="Bold" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="💡 Recomendado: Logo cuadrado (1:1) o rectangular (4:3) de al menos 300x300px." 
                                       FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,0,0,20"/>

                            <TextBlock Text="Reglas de Compromiso por Defecto" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,10"/>
                            <Border Background="#F9F9F9" Padding="15" CornerRadius="8" Margin="0,0,0,20" BorderBrush="#EEE" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Seleccionar categoría para definir días de asistencia obligatorios:" Margin="0,0,0,10" FontSize="12" Foreground="#555"/>
                                    <ComboBox SelectedItem="{Binding CategoriaConfig}" Margin="0,0,0,15" Padding="10">
                                        <x:Static Member="models:Categoria.Pastor"/>
                                        <x:Static Member="models:Categoria.Diacono"/>
                                        <x:Static Member="models:Categoria.Miembro"/>
                                        <x:Static Member="models:Categoria.Seguimiento"/>
                                    </ComboBox>
                                    
                                    <TextBlock Text="Días marcados automáticamente al registrar:" Margin="0,0,0,10" FontSize="12" FontWeight="SemiBold"/>
                                    <WrapPanel Margin="0,0,0,15">
                                        <CheckBox Content="Dom" IsChecked="{Binding DefDom}" Margin="0,0,20,8"/>
                                        <CheckBox Content="Lun" IsChecked="{Binding DefLun}" Margin="0,0,20,8"/>
                                        <CheckBox Content="Mar" IsChecked="{Binding DefMar}" Margin="0,0,20,8"/>
                                        <CheckBox Content="Mie" IsChecked="{Binding DefMie}" Margin="0,0,20,8"/>
                                        <CheckBox Content="Jue" IsChecked="{Binding DefJue}" Margin="0,0,20,8"/>
                                        <CheckBox Content="Vie" IsChecked="{Binding DefVie}" Margin="0,0,20,8"/>
                                        <CheckBox Content="Sab" IsChecked="{Binding DefSab}" Margin="0,0,20,8"/>
                                    </WrapPanel>
                                    
                                    <Button Content="GUARDAR REGLA" Command="{Binding GuardarDiasDefaultCommand}" 
                                            Background="#3F51B5" Foreground="White" Padding="25,12" FontWeight="Bold" BorderThickness="0" HorizontalAlignment="Left">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Rutas de Almacenamiento" FontSize="16" FontWeight="Bold" Margin="0,10,0,15"/>
                            
                            <TextBlock Text="Carpeta de Reportes PDF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding RutaReportesConfigurada}" Padding="10" IsReadOnly="True" Background="#F0F0F0" BorderThickness="1,1,0,1"/>
                                <Button Grid.Column="1" Content="CAMBIAR" Command="{Binding SeleccionarRutaReportesCommand}" Padding="15,5" Background="#3F51B5" Foreground="White" BorderThickness="0"/>
                            </Grid>

                            <TextBlock Text="Carpeta de Backups Automáticos" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding RutaBackupConfigurada}" Padding="10" IsReadOnly="True" Background="#F0F0F0" BorderThickness="1,1,0,1"/>
                                <Button Grid.Column="1" Content="CAMBIAR" Command="{Binding SeleccionarRutaBackupCommand}" Padding="15,5" Background="#757575" Foreground="White" BorderThickness="0"/>
                            </Grid>
                            
                            <Separator Margin="0,30,0,20"/>

                            <TextBlock Text="Mantenimiento Crítico" FontSize="14" FontWeight="Bold" Foreground="#D32F2F" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Content="🗑️ REINICIAR TODO EL SISTEMA (VACIAR BD)" Command="{Binding ResetearSistemaCommand}" 
                                        Background="#FF5252" Foreground="White" Padding="30,12" FontWeight="Bold" BorderThickness="0" Margin="0,0,15,0">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>
                            
                            <TextBlock Text="Nota: El sistema realiza un backup automático cada vez que se cierra la aplicación." 
                                       FontStyle="Italic" Foreground="Gray" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- VISTA: DIRECTORIO -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentView}" Value="Personas"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PremiumCard}" Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Directorio de Miembros" FontSize="20" FontWeight="Bold"/>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="➕ NUEVO" 
                                        Command="{Binding LimpiarFormularioCommand}" Padding="15,5" FontSize="12" Background="#4CAF50"/>
                            </Grid>
                            
                            <TextBox Grid.Row="1" Text="{Binding SearchTextPersonas, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,15" Padding="10" BorderBrush="#DDD" FontSize="14"/>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding PersonasFiltradas}" AutoGenerateColumns="False" 
                                      IsReadOnly="True" Background="Transparent" BorderThickness="0" 
                                      SelectionMode="Single" AlternatingRowBackground="#F5F5F5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                    <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="100"/>
                                    <DataGridTemplateColumn Header="Acciones" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="✏️" Command="{Binding DataContext.PrepararEdicionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Margin="0,0,10,0"/>
                                                    <Button Content="🗑️" Command="{Binding DataContext.EliminarPersonaCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource PremiumCard}" Grid.Column="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="5">
                                <TextBlock Text="Datos del Registro" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Categoría" FontSize="12" Foreground="Indigo"/>
                                <ComboBox SelectedValue="{Binding NuevaCategoria}" Margin="0,2,0,10" Padding="8">
                                    <x:Static Member="models:Categoria.Pastor"/>
                                    <x:Static Member="models:Categoria.Diacono"/>
                                    <x:Static Member="models:Categoria.Miembro"/>
                                    <x:Static Member="models:Categoria.Visita"/>
                                    <x:Static Member="models:Categoria.Seguimiento"/>
                                </ComboBox>

                                <TextBlock Text="Nombre Completo *" FontSize="12" Foreground="Indigo"/>
                                <TextBox Text="{Binding NuevoNombre}" Margin="0,2,0,10" Padding="8"/>

                                <!-- Grupo 1: Teléfono y Fecha Nacimiento -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Teléfono" FontSize="12" Foreground="Indigo"/>
                                        <TextBox Text="{Binding NuevoTelefono}" Margin="0,2,0,0" Padding="8"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NuevaCategoria}" Value="{x:Static models:Categoria.Visita}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Fecha Nacimiento" FontSize="12" Foreground="Indigo"/>
                                        <DatePicker SelectedDate="{Binding NuevaFechaNacimiento}" Margin="0,2,0,0" Padding="5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Grupo 2: Aceptó a Cristo y Bautismo -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <CheckBox Content="¿Aceptó a Cristo?" IsChecked="{Binding NuevaAceptoCristo}" FontSize="13" FontWeight="Bold" Foreground="DarkGreen"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NuevaCategoria}" Value="{x:Static models:Categoria.Visita}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <CheckBox Content="¿Bautizado?" IsChecked="{Binding NuevaEstaBautizado}" FontSize="13" FontWeight="Bold" Foreground="DarkBlue"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Campos especiales para Visitas -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NuevaCategoria}" Value="{x:Static models:Categoria.Visita}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Quien lo invitó (Opcional)" FontSize="12" Foreground="Indigo"/>
                                    <TextBox Text="{Binding NuevaQuienLoInvito}" Margin="0,2,0,10" Padding="8"/>
                                    
                                    <CheckBox Content="Registrar visita para HOY" IsChecked="{Binding VisitoHoy}" FontWeight="Bold" Margin="0,0,0,10"/>
                                </StackPanel>

                                <TextBlock Text="Compromiso de Asistencia" FontSize="12" Foreground="Indigo" Margin="0,0,0,5"/>
                                <WrapPanel Margin="0,0,0,15">
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NuevaCategoria}" Value="{x:Static models:Categoria.Visita}">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>
                                    <CheckBox Content="Dom" IsChecked="{Binding NuevaCompromisoDomingo}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Lun" IsChecked="{Binding NuevaCompromisoLunes}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Mar" IsChecked="{Binding NuevaCompromisoMartes}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Mie" IsChecked="{Binding NuevaCompromisoMiercoles}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Jue" IsChecked="{Binding NuevaCompromisoJueves}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Vie" IsChecked="{Binding NuevaCompromisoViernes}" Margin="0,0,10,5"/>
                                    <CheckBox Content="Sab" IsChecked="{Binding NuevaCompromisoSabado}" Margin="0,0,10,5"/>
                                </WrapPanel>
                                
                                <Button Style="{StaticResource PrimaryButton}" Content="GUARDAR INFORMACIÓN" Command="{Binding RegistrarNuevaPersonaCommand}" Margin="0,5,0,5"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- VISTA: ASISTENCIA -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PremiumCard}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentView}" Value="Asistencia"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Control de Asistencia" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <TextBox Grid.Row="1" Text="{Binding SearchTextAsistencia, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,15" Padding="10" BorderBrush="#DDD" FontSize="14"/>

                        <ScrollViewer Grid.Row="2">
                            <ItemsControl ItemsSource="{Binding AsistenciaFiltrada}" AlternationCount="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1">
                                                            <Setter Property="Background" Value="#F5F5F5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nombre}" FontSize="18" FontWeight="SemiBold"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Categoria}" Foreground="Indigo" FontSize="13" Margin="0,0,10,0"/>
                                                        <TextBlock Text="⚠️ Excusa marcada" Foreground="#E65100" FontSize="13" FontWeight="SemiBold" Visibility="{Binding IsExcusa, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Nota de Excusa -->
                                                    <StackPanel Margin="0,5,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsExcusa}" Value="True"/>
                                                                            <Condition Binding="{Binding EsVisita}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="Razón de la excusa (Se guarda automáticamente):" FontSize="11" Foreground="Gray"/>
                                                        <TextBox Text="{Binding CurrentNotaExcusa}" 
                                                                 Padding="5" Margin="0,2,0,0">
                                                            <i:Interaction.Triggers>
                                                                <i:EventTrigger EventName="LostFocus">
                                                                    <i:InvokeCommandAction Command="{Binding DataContext.GuardarNotaExcusaCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                </i:EventTrigger>
                                                            </i:Interaction.Triggers>
                                                        </TextBox>
                                                    </StackPanel>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Control para Miembros/Líderes: Checkbox -->
                                                    <StackPanel Margin="0,0,20,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Categoria}" Value="{x:Static models:Categoria.Visita}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="Asistió" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                        <CheckBox IsChecked="{Binding IsPresente}" Command="{Binding DataContext.ToggleAsistenciaCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Center">
                                                            <CheckBox.LayoutTransform><ScaleTransform ScaleX="1.5" ScaleY="1.5"/></CheckBox.LayoutTransform>
                                                        </CheckBox>
                                                    </StackPanel>

                                                    <!-- Control para Visitas: Solo lectura -->
                                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Categoria}" Value="{x:Static models:Categoria.Visita}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Border Background="Indigo" CornerRadius="4" Padding="10,5">
                                                            <TextBlock Text="✅ PRESENTE" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Control de Excusa (Solo Miembros) -->
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Categoria}" Value="{x:Static models:Categoria.Visita}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="Excusa" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                                        <CheckBox IsChecked="{Binding IsExcusa}" Command="{Binding DataContext.ToggleExcusaCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Center">
                                                            <CheckBox.LayoutTransform><ScaleTransform ScaleX="1.5" ScaleY="1.5"/></CheckBox.LayoutTransform>
                                                        </CheckBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
