<Window x:Class="IglesiaAsistencia.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IglesiaAsistencia.ViewModels"
        xmlns:models="clr-namespace:IglesiaAsistencia.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Asistencia Pro - Comunidad del Reino" Height="850" Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="White" BorderBrush="#EEE" BorderThickness="0,0,1,0">
            <Grid Margin="0,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="20,0,20,40">
                    <TextBlock Text="⛪" FontSize="50" HorizontalAlignment="Center"/>
                    <TextBlock Text="Comunidad del Reino" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource MenuButton}" Content="📊 Dashboard" Command="{Binding CambiarVistaCommand}" CommandParameter="Dashboard"/>
                    <Button Style="{StaticResource MenuButton}" Content="👥 Directorio" Command="{Binding CambiarVistaCommand}" CommandParameter="Personas"/>
                    <Button Style="{StaticResource MenuButton}" Content="📋 Asistencia" Command="{Binding CambiarVistaCommand}" CommandParameter="Asistencia"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="15">
                    <Button Style="{StaticResource MenuButton}" Content="⚙️ Configuración" Command="{Binding CambiarVistaCommand}" CommandParameter="Configuracion" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding GenerarBackupCommand}" Content="💾 Backup Manual" Background="#4CAF50"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido Principal -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding CurrentView}" FontSize="32" FontWeight="Bold" Foreground="#222"/>
                    <TextBlock Text="Gestión Inteligente de la Congregación" Foreground="Gray"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker SelectedDate="{Binding FechaSeleccionada}" Width="140" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding EnviarReporteCommand}" Content="ENVIAR REPORTE WA"/>
                </StackPanel>
            </Grid>

            <!-- Secciones -->
            <Grid Grid.Row="1">
                
                <!-- VISTA: DASHBOARD -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding CurrentView}" Value="Dashboard"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource PremiumCard}" Background="#E8EAF6">
                                <StackPanel>
                                    <TextBlock Text="Asistentes Hoy" Foreground="#5C6BC0" FontWeight="Bold" FontSize="18"/>
                                    <TextBlock Text="{Binding AsistentesHoy.Count}" FontSize="48" FontWeight="Bold" Margin="0,10"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PremiumCard}" Background="#E1F5FE">
                                <StackPanel>
                                    <TextBlock Text="Total Personas" Foreground="#0288D1" FontWeight="Bold" FontSize="18"/>
                                    <TextBlock Text="{Binding Personas.Count}" FontSize="48" FontWeight="Bold" Margin="0,10"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PremiumCard}" Background="#FFF3E0">
                                <StackPanel>
                                    <TextBlock Text="🎂 Cumpleaños de la Semana" Foreground="#F57C00" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding CumpleañerosSemana}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="SemiBold" Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Ninguna novedad" FontStyle="Italic" Foreground="Gray" Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HayCumpleaños}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        
                        <Border Style="{StaticResource PremiumCard}" Margin="10,20,10,10">
                            <StackPanel>
                                <TextBlock Text="📄 Generar Reportes PDF Estadísticos" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportarReporteDomingosCommand}" Content="Reporte de DOMINGOS" Background="Indigo" Margin="0,0,10,10"/>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportarReporteRangoCommand}" CommandParameter="Semana" Content="Reporte Semanal" Margin="0,0,10,10"/>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportarReporteRangoCommand}" CommandParameter="Mes" Content="Reporte Mensual" Margin="0,0,10,10"/>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportarReporteRangoCommand}" CommandParameter="Año" Content="Reporte Anual" Margin="0,0,10,10"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- VISTA: CONFIGURACION -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PremiumCard}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentView}" Value="Configuracion"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Configuración del Sistema" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Ruta para Copias de Seguridad Automáticas" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10" Background="#F9F9F9">
                            <TextBlock Text="{Binding RutaBackupConfigurada}" Foreground="DimGray" TextWrapping="Wrap"/>
                        </Border>
                        
                        <Button Style="{StaticResource PrimaryButton}" Content="Cambiar Carpeta de Backup" Command="{Binding SeleccionarRutaBackupCommand}" Margin="0,15,0,0" HorizontalAlignment="Left"/>
                        
                        <Separator Margin="0,40,0,20"/>

                        <TextBlock Text="Mantenimiento del Sistema" FontSize="16" FontWeight="Bold" Foreground="Red" Margin="0,0,0,10"/>
                        <TextBlock Text="Estas acciones borrarán datos permanentemente." Foreground="Gray" Margin="0,0,0,15"/>
                        <Button Content="REINICIAR TODO EL SISTEMA" Background="#FF5252" Foreground="White" 
                                Command="{Binding ResetearSistemaCommand}" Padding="20,10" FontWeight="Bold"
                                HorizontalAlignment="Left" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <TextBlock Text="Nota: El programa realizará un backup automático en esta ruta cada vez que se cierre la aplicación." 
                                   FontStyle="Italic" Foreground="Gray" Margin="0,30,0,0"/>
                    </StackPanel>
                </Border>

                <!-- VISTA: DIRECTORIO -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentView}" Value="Personas"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PremiumCard}" Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Directorio de Miembros" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                            
                            <TextBox Grid.Row="1" Text="{Binding SearchTextPersonas, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,15" Padding="10" BorderBrush="#DDD" FontSize="14"/>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding PersonasFiltradas}" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent" BorderThickness="0" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                    <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="100"/>
                                    <DataGridTemplateColumn Header="Acciones" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="✏️" Command="{Binding DataContext.PrepararEdicionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Margin="0,0,10,0"/>
                                                    <Button Content="🗑️" Command="{Binding DataContext.EliminarPersonaCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PremiumCard}" Grid.Column="1">
                        <StackPanel>
                            <TextBlock Text="Datos del Registro" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                            
                            <TextBlock Text="Nombre Completo *" FontSize="12" Foreground="Indigo"/>
                            <TextBox Text="{Binding NuevoNombre}" Margin="0,5,0,15" Padding="8"/>
                            
                            <TextBlock Text="Teléfono" FontSize="12" Foreground="Indigo"/>
                            <TextBox Text="{Binding NuevoTelefono}" Margin="0,5,0,15" Padding="8"/>
                            
                            <TextBlock Text="Fecha Nacimiento" FontSize="12" Foreground="Indigo"/>
                            <DatePicker SelectedDate="{Binding NuevaFechaNacimiento}" Margin="0,5,0,15" Padding="5"/>
                            
                            <TextBlock Text="Categoría" FontSize="12" Foreground="Indigo"/>
                            <ComboBox SelectedValue="{Binding NuevaCategoria}" Margin="0,5,0,25" Padding="8">
                                <models:Categoria>Pastor</models:Categoria>
                                <models:Categoria>Diacono</models:Categoria>
                                <models:Categoria>Miembro</models:Categoria>
                                <models:Categoria>Adolescente</models:Categoria>
                                <models:Categoria>Invitado</models:Categoria>
                            </ComboBox>
                            
                            <Button Style="{StaticResource PrimaryButton}" Content="GUARDAR INFORMACIÓN" Command="{Binding RegistrarNuevaPersonaCommand}"/>
                            <Button Content="Cancelar Edición" Visibility="{Binding EsModoEdicion, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding CambiarVistaCommand}" CommandParameter="Personas" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- VISTA: ASISTENCIA -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PremiumCard}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentView}" Value="Asistencia"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Control de Asistencia" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <TextBox Grid.Row="1" Text="{Binding SearchTextAsistencia, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,15" Padding="10" BorderBrush="#DDD" FontSize="14"/>

                        <ScrollViewer Grid.Row="2">
                            <ItemsControl ItemsSource="{Binding AsistenciaFiltrada}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Nombre}" FontSize="18" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Categoria}" Foreground="Indigo" FontSize="13"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsPresente}" Command="{Binding DataContext.ToggleAsistenciaCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center">
                                                    <CheckBox.LayoutTransform><ScaleTransform ScaleX="1.6" ScaleY="1.6"/></CheckBox.LayoutTransform>
                                                </CheckBox>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
